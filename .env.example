# =============================================
# Dr. Massuca - Variáveis de Ambiente
# =============================================
# Copie este arquivo para .env e preencha com suas credenciais
# NUNCA comite o arquivo .env com credenciais reais!

# Google Gemini API (para geração de conteúdo com IA)
# Obtenha em: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=sua_api_key_aqui

# Supabase (banco de dados e autenticação)
# Dashboard: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Supabase service role (server-only — NUNCA com prefixo VITE_)
# Pegue no Dashboard: Project Settings → API → service_role secret
# Usado apenas em Vercel Functions (api/*) para bypassar RLS em ações admin.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# === Memo3D - Cloudflare R2 (fotos e book 3D) ===
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=memo3d
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com

# === Memo3D - Cloudflare Stream (vídeos) ===
# CLOUDFLARE_ACCOUNT_ID é o mesmo do R2 — copiar.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=customer-XXXX.cloudflarestream.com

# === Memo3D - Mercado Pago (compra de créditos de IA) ===
# Painel: https://www.mercadopago.com.br/developers/panel/app
# MP_ACCESS_TOKEN: Credenciais → Access token (sandbox: TEST-..., produção: APP_USR-...).
# MP_WEBHOOK_SECRET: Webhooks → Configurações → Chave secreta (HMAC).
# MEMO3D_BASE_URL (opcional): URL pública pra back_urls/notification_url.
#   Se ausente, é derivada do request (host header).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MEMO3D_BASE_URL=https://drmassuca.com.br
